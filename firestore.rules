rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email.lower().matches('^[^@\\s]+@(students[.]geneseeisd[.]org|geneseeisd[.]org)$');
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isAssigned(courseId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('archived', false) == false
        && exists(/databases/$(database)/documents/assignments/$(request.auth.uid + '_' + courseId))
        && get(/databases/$(database)/documents/assignments/$(request.auth.uid + '_' + courseId)).data.get('archived', false) == false;
    }

    function coursePublished(courseId) {
      return exists(/databases/$(database)/documents/courses/$(courseId))
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid) && request.resource.data.role == 'student'
        && request.resource.data.get('archived', false) == false
        && !('archiveId' in request.resource.data);
      allow update: if isAdmin()
        || (isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'lastLoginAt']));
      allow delete: if false;
    }

    match /courses/{courseId} {
      allow read: if isAdmin()
        || (isAssigned(courseId) && resource.data.status == 'published');
      allow create, update: if isAdmin();
      allow delete: if false;

      match /lessons/{lessonId} {
        allow read: if isAdmin() || (isAssigned(courseId) && coursePublished(courseId));
        allow create, update, delete: if isAdmin();

        match /questions/{questionId} {
          allow read: if isAdmin() || (isAssigned(courseId) && coursePublished(courseId));
          allow create, update, delete: if isAdmin();
        }
      }
    }

    match /assignments/{assignmentId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && isAssigned(resource.data.courseId)
          && coursePublished(resource.data.courseId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['in_progress', 'completed']);
    }

    match /progress/{progressId} {
      // First-time learners have no progress document. An empty get contains no
      // student data; existing documents and collection queries remain owner-only.
      allow get: if isAdmin() || (signedIn()
        && (!exists(/databases/$(database)/documents/progress/$(progressId))
          || resource.data.uid == request.auth.uid));
      allow list: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && isAssigned(request.resource.data.courseId)
        && coursePublished(request.resource.data.courseId);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.courseId == resource.data.courseId
          && isAssigned(resource.data.courseId)
          && coursePublished(resource.data.courseId));
      allow delete: if isAdmin();
    }

    function archiveMember(archiveId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/classArchives/$(archiveId)).data.studentIds;
    }

    match /classArchives/{archiveId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid in resource.data.studentIds);
      allow create, update: if isAdmin();
      match /{collection}/{document} {
        allow read: if isAdmin() || (archiveMember(archiveId)
          && ((collection in ['courses', 'lessons'] && request.auth.uid in resource.data.studentIds)
            || (collection in ['users', 'assignments', 'progress', 'attempts'] && resource.data.uid == request.auth.uid)));
        allow create, update: if isAdmin();
      }
    }

    match /attempts/{attemptId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && isAssigned(request.resource.data.courseId)
        && coursePublished(request.resource.data.courseId)
        && request.resource.data.totalQuestions > 0
        && request.resource.data.scorePercent >= 0
        && request.resource.data.scorePercent <= 100;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived', 'archiveId']);
      allow delete: if false;
    }
  }
}
